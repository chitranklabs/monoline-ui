{
	"name": "monoline",
	"version": "0.4.0",
	"private": true,
	"description": "Monochrome React component library for developer portfolios, documentation, and editorial interfaces with Tailwind CSS v4 design tokens.",
	"type": "module",
	"author": {
		"name": "Chitrank Agnihotri",
		"email": "chitrank2050@gmail.com",
		"url": "https://chitrankagnihotri.com"
	},
	"homepage": "https://monolineui.chitrankagnihotri.com/",
	"repository": {
		"type": "git",
		"url": "https://github.com/chitranklabs/monoline-ui"
	},
	"bugs": {
		"url": "https://github.com/chitranklabs/monoline-ui/issues"
	},
	"scripts": {
		"dev": "pnpm build:lib && pnpm --filter @monoline/website dev",
		"build": "pnpm build:lib && pnpm --filter @monoline/website build",
		"start": "pnpm --filter @monoline/website start",
		"sync-exports": "node scripts/sync-exports.mjs",
		"sync-exports:check": "node scripts/sync-exports.mjs --check",
		"build:lib": "pnpm run sync-exports:check && node scripts/build-lib.mjs",
		"build:all": "pnpm build",
		"check:static": "pnpm sync-exports:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:ci && pnpm test",
		"check:package": "pnpm build:lib && pnpm test:package && pnpm test:react18",
		"check:all": "pnpm check:static && pnpm check:package && pnpm test:docs",
		"lint": "eslint . && pnpm run lint:md",
		"lint:fix": "eslint . --fix && pnpm run lint:md --fix",
		"lint:md": "markdownlint \"**/*.md\" --ignore node_modules --ignore CHANGELOG.md --ignore playwright-report --ignore test-results",
		"lint:branch": "git-hygiene branch",
		"test": "vitest run",
		"test:ci": "node --test scripts/ci-workflows.test.mjs scripts/migration-contract.test.mjs scripts/project-paths.test.mjs",
		"test:package": "node scripts/package-contract-test.mjs",
		"test:react18": "node scripts/react-18-compatibility-test.mjs",
		"test:browser": "playwright test",
		"test:browser:install": "playwright install chromium",
		"test:docs": "pnpm build && pnpm test:docs:built",
		"test:docs:built": "node scripts/run-docs-integration.mjs",
		"test:seo": "pnpm run build && pnpm run test:seo:built",
		"test:seo:built": "node scripts/seo-integration-test.mjs",
		"test:watch": "vitest",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"deps:update": "pnpm update --interactive --latest",
		"typecheck": "pnpm build:lib && pnpm --filter @chitrank2050/monoline-ui typecheck && pnpm --filter @monoline/website typecheck && tsc --noEmit",
		"init": "./scripts/install.sh",
		"nuke": "./scripts/obliviate.sh",
		"clean-setup": "pnpm run nuke && pnpm run init",
		"clean-build": "pnpm run nuke && pnpm run init && pnpm run build:all"
	},
	"devDependencies": {
		"@chitrank2050/git-hygiene": "^0.4.12",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "1.60.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/node": "^26.4.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"axe-core": "4.13.0",
		"esbuild": "^0.28.1",
		"eslint": "^10.8.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"globals": "^17.8.0",
		"js-yaml": "5.4.1",
		"jsdom": "^30.0.1",
		"lefthook": "^2.1.10",
		"markdownlint-cli": "^0.49.1",
		"picomatch": "4.0.7",
		"prettier": "^3.9.6",
		"react-dom18": "npm:react-dom@18.2.0",
		"react18": "npm:react@18.2.0",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vitest": "^4.1.11",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"packageManager": "pnpm@11.18.0",
	"engines": {
		"node": ">=24.14.0"
	},
	"git-hygiene": {
		"types": [
			"feat",
			"fix",
			"chore",
			"docs",
			"style",
			"refactor",
			"perf",
			"test",
			"build",
			"ci",
			"revert",
			"maintenance",
			"renovate"
		],
		"ignoreBranches": [
			"main",
			"master",
			"gh-pages"
		]
	}
}
