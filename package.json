{
	"name": "monoline",
	"version": "0.1.0",
	"private": true,
	"description": "Monoline UI design library and Next.js playground.",
	"type": "module",
	"author": {
		"name": "Chitrank Agnihotri",
		"email": "chitrank2050@gmail.com",
		"url": "https://www.chitrankagnihotri.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/chitranklabs/monoline-ui"
	},
	"scripts": {
		"dev": "pnpm --filter @monoline/playground dev",
		"build": "pnpm --filter @chitrank2050/monoline-ui build",
		"build:playground": "pnpm --filter @monoline/playground build",
		"build:all": "pnpm -r build",
		"lint": "pnpm -r lint && eslint .",
		"lint:fix": "pnpm -r lint:fix && eslint . --fix",
		"lint:branch": "git-hygiene branch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "echo \"Tests are intentionally skipped for Phase 1\"",
		"prepare": "lefthook install",
		"lefthook": "lefthook"
	},
	"devDependencies": {
		"@chitrank2050/git-hygiene": "^0.4.11",
		"@eslint/js": "^9.18.0",
		"eslint": "^9.18.0",
		"globals": "^16.0.0",
		"lefthook": "^1.13.6",
		"prettier": "^3.4.2",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.58.0"
	},
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=10.0.0"
	},
	"git-hygiene": {
		"types": [
			"feat",
			"fix",
			"chore",
			"docs",
			"style",
			"refactor",
			"perf",
			"build",
			"ci",
			"revert",
			"maintenance",
			"renovate"
		],
		"ignoreBranches": [
			"main",
			"master",
			"gh-pages"
		]
	}
}
