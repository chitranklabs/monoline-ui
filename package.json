{
	"name": "monoline",
	"version": "0.1.0",
	"private": true,
	"description": "Monoline UI design library and Next.js playground.",
	"type": "module",
	"author": {
		"name": "Chitrank Agnihotri",
		"email": "chitrank2050@gmail.com",
		"url": "https://www.chitrankagnihotri.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/chitranklabs/monoline-ui"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"postbuild": "next-sitemap",
		"start": "next start",
		"build:lib": "node scripts/sync-exports.mjs && node scripts/build-lib.mjs",
		"build:all": "pnpm build && pnpm build:lib",
		"lint": "eslint . && pnpm run lint:md",
		"lint:fix": "eslint . --fix && pnpm run lint:md --fix",
		"lint:md": "markdownlint \"**/*.md\" --ignore node_modules --ignore CHANGELOG.md",
		"lint:branch": "git-hygiene branch",
		"test": "tsc --noEmit --pretty false",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"deps:update": "pnpm update --interactive --latest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@radix-ui/react-slot": "^1.2.5",
		"@tailwindcss/postcss": "^4.2.0",
		"@vercel/analytics": "^2.0.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"next": "^16.2.7",
		"prismjs": "^1.30.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.2.0"
	},
	"devDependencies": {
		"@chitrank2050/git-hygiene": "^0.4.11",
		"@eslint/js": "^10.0.1",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/node": "^25.9.2",
		"@types/prismjs": "^1.26.6",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.0.0",
		"babel-plugin-react-compiler": "^1.0.0",
		"eslint": "^10.4.1",
		"globals": "^17.6.0",
		"lefthook": "^2.1.9",
		"markdownlint-cli": "^0.48.0",
		"next-sitemap": "^4.2.3",
		"prettier": "^3.4.2",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.60.1",
		"vitest": "^4.1.8"
	},
	"packageManager": "pnpm@11.5.2",
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=10.0.0"
	},
	"git-hygiene": {
		"types": [
			"feat",
			"fix",
			"chore",
			"docs",
			"style",
			"refactor",
			"perf",
			"test",
			"build",
			"ci",
			"revert",
			"maintenance",
			"renovate"
		],
		"ignoreBranches": [
			"main",
			"master",
			"gh-pages"
		]
	}
}
