{
	"name": "monoline",
	"version": "0.2.3",
	"private": true,
	"description": "Monochrome React component library for developer portfolios, documentation, and editorial interfaces with Tailwind CSS v4 design tokens.",
	"type": "module",
	"author": {
		"name": "Chitrank Agnihotri",
		"email": "chitrank2050@gmail.com",
		"url": "https://chitrankagnihotri.com"
	},
	"homepage": "https://monolineui.chitrankagnihotri.com/",
	"repository": {
		"type": "git",
		"url": "https://github.com/chitranklabs/monoline-ui"
	},
	"bugs": {
		"url": "https://github.com/chitranklabs/monoline-ui/issues"
	},
	"scripts": {
		"dev": "NODE_OPTIONS='--max-old-space-size=4096' next dev",
		"build": "next build",
		"start": "next start",
		"sync-exports": "node scripts/sync-exports.mjs",
		"sync-exports:check": "node scripts/sync-exports.mjs --check",
		"build:lib": "pnpm run sync-exports:check && node scripts/build-lib.mjs",
		"build:all": "pnpm build && pnpm build:lib",
		"lint": "eslint . && pnpm run lint:md",
		"lint:fix": "eslint . --fix && pnpm run lint:md --fix",
		"lint:md": "markdownlint \"**/*.md\" --ignore node_modules --ignore CHANGELOG.md",
		"lint:branch": "git-hygiene branch",
		"test": "vitest run",
		"test:seo": "pnpm run build && pnpm run test:seo:built",
		"test:seo:built": "node scripts/seo-integration-test.mjs",
		"test:watch": "vitest",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"deps:update": "pnpm update --interactive --latest",
		"typecheck": "tsc --noEmit",
		"init": "./scripts/install.sh",
		"nuke": "./scripts/obliviate.sh",
		"clean-setup": "pnpm run nuke && pnpm run init",
		"clean-build": "pnpm run nuke && pnpm run init && pnpm run build:all"
	},
	"dependencies": {
		"@radix-ui/react-slot": "^1.3.3",
		"@tailwindcss/postcss": "^4.3.3",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"next": "^16.3.3",
		"prismjs": "^1.30.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@chitrank2050/git-hygiene": "^0.4.12",
		"@eslint/js": "^10.0.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/node": "^26.4.0",
		"@types/prismjs": "^1.26.6",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"babel-plugin-react-compiler": "^1.0.0",
		"esbuild": "^0.28.1",
		"eslint": "^10.8.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"globals": "^17.8.0",
		"jsdom": "^30.0.1",
		"lefthook": "^2.1.10",
		"markdownlint-cli": "^0.49.1",
		"prettier": "^3.9.6",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vitest": "^4.1.11"
	},
	"packageManager": "pnpm@11.18.0",
	"engines": {
		"node": ">=24.14.0"
	},
	"git-hygiene": {
		"types": [
			"feat",
			"fix",
			"chore",
			"docs",
			"style",
			"refactor",
			"perf",
			"test",
			"build",
			"ci",
			"revert",
			"maintenance",
			"renovate"
		],
		"ignoreBranches": [
			"main",
			"master",
			"gh-pages"
		]
	}
}
