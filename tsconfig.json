{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"allowJs": false,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"incremental": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"paths": {
			"@/*": ["./app/*"],
			"@chitrank2050/monoline-ui": ["./src/index.ts"],
			"@chitrank2050/monoline-ui/avatar": ["./src/components/avatar"],
			"@chitrank2050/monoline-ui/button": ["./src/components/button"],
			"@chitrank2050/monoline-ui/card": ["./src/components/card"],
			"@chitrank2050/monoline-ui/data-list": ["./src/components/data-list"],
			"@chitrank2050/monoline-ui/eyebrow": ["./src/components/eyebrow"],
			"@chitrank2050/monoline-ui/footer": ["./src/components/footer"],
			"@chitrank2050/monoline-ui/metric": ["./src/components/metric"],
			"@chitrank2050/monoline-ui/navbar": ["./src/components/navbar"],
			"@chitrank2050/monoline-ui/section-head": [
				"./src/components/section-head"
			],
			"@chitrank2050/monoline-ui/segmented-control": [
				"./src/components/segmented-control"
			],
			"@chitrank2050/monoline-ui/status": ["./src/components/status"],
			"@chitrank2050/monoline-ui/tag": ["./src/components/tag"],
			"@chitrank2050/monoline-ui/testimonial": ["./src/components/testimonial"],
			"@chitrank2050/monoline-ui/testimonial-grid": [
				"./src/components/testimonial-grid"
			],
			"@chitrank2050/monoline-ui/theme-switcher": [
				"./src/components/theme-switcher"
			],
			"@chitrank2050/monoline-ui/toggle": ["./src/components/toggle"],
			"@chitrank2050/monoline-ui/*": ["./src/*"]
		},
		"esModuleInterop": true,
		"noUncheckedIndexedAccess": true,
		"ignoreDeprecations": "6.0"
	},
	"include": [
		"next-env.d.ts",
		"app/**/*.ts",
		"app/**/*.tsx",
		"src/**/*.ts",
		"src/**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts"
	],
	"exclude": ["node_modules", "dist"]
}
