{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"allowJs": false,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"incremental": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"paths": {
			"@/*": ["./app/*"],
			"@chitrank2050/monoline-ui": ["./src/index.ts"],
			"@chitrank2050/monoline-ui/footer": ["./src/components/footer"],
			"@chitrank2050/monoline-ui/button": ["./src/components/button"],
			"@chitrank2050/monoline-ui/toggle": ["./src/components/toggle"],
			"@chitrank2050/monoline-ui/tag": ["./src/components/tag"],
			"@chitrank2050/monoline-ui/*": ["./src/*"]
		},
		"esModuleInterop": true,
		"noUncheckedIndexedAccess": true,
		"ignoreDeprecations": "6.0"
	},
	"include": [
		"next-env.d.ts",
		"app/**/*.ts",
		"app/**/*.tsx",
		"src/**/*.ts",
		"src/**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts"
	],
	"exclude": ["node_modules", "dist"]
}
