{
	"name": "@chitrank2050/monoline-ui",
	"version": "0.1.0",
	"description": "A React footer component and Tailwind CSS theme for Chitrank's portfolio interface.",
	"type": "module",
	"author": {
		"name": "Chitrank Agnihotri",
		"email": "chitrank2050@gmail.com",
		"url": "https://www.chitrankagnihotri.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/chitranklabs/monoline-ui"
	},
	"bugs": {
		"url": "https://github.com/chitranklabs/monoline-ui/issues"
	},
	"keywords": [
		"react",
		"footer",
		"tailwindcss",
		"portfolio",
		"ui"
	],
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"README.md"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": [
		"./dist/styles/theme.css"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"development": "./src/index.ts",
			"import": "./dist/index.js"
		},
		"./footer": {
			"types": "./dist/components/footer.d.ts",
			"development": "./src/components/footer.tsx",
			"import": "./dist/components/footer.js"
		},
		"./components/*": {
			"types": "./dist/components/*.d.ts",
			"development": "./src/components/*.tsx",
			"import": "./dist/components/*.js"
		},
		"./foundations/*": {
			"types": "./dist/foundations/*.d.ts",
			"development": "./src/foundations/*.ts",
			"import": "./dist/foundations/*.js"
		},
		"./theme.css": {
			"development": "./src/foundations/theme.css",
			"default": "./dist/styles/theme.css"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json && mkdir -p dist/styles && cp src/foundations/theme.css dist/styles/theme.css",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"prepack": "pnpm build"
	},
	"peerDependencies": {
		"react": "^18.2.0 || ^19.0.0",
		"react-dom": "^18.2.0 || ^19.0.0",
		"tailwindcss": ">=4.0.0"
	},
	"peerDependenciesMeta": {
		"tailwindcss": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwindcss": "^4.2.0"
	}
}
