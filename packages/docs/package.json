{
	"name": "@monoline/docs",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./build": {
			"types": "./dist/build.d.ts",
			"default": "./dist/build.js"
		},
		"./dev": {
			"types": "./dist/dev.d.ts",
			"default": "./dist/dev.js"
		}
	},
	"bin": {
		"monoline-docs": "./dist/cli.js"
	},
	"files": [
		"dist",
		"templates"
	],
	"engines": {
		"node": ">=24.21.0"
	},
	"dependencies": {
		"js-yaml": "5.4.2",
		"markdown-it": "15.0.2",
		"prismjs": "1.30.0"
	},
	"devDependencies": {
		"@types/prismjs": "1.26.6"
	},
	"scripts": {
		"build": "node build.mjs",
		"test:consumer": "node test-consumer.mjs",
		"typecheck": "tsc --noEmit"
	}
}
