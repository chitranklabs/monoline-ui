{
	"name": "@chitrank2050/monoline-docs",
	"version": "0.0.0",
	"description": "A fast, static documentation builder for Markdown and MDX with Monoline's accessible interface.",
	"type": "module",
	"author": {
		"name": "Chitrank Agnihotri",
		"email": "chitrank2050@gmail.com",
		"url": "https://chitrankagnihotri.com"
	},
	"homepage": "https://github.com/chitranklabs/monoline-ui/tree/main/packages/docs",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/chitranklabs/monoline-ui.git",
		"directory": "packages/docs"
	},
	"bugs": {
		"url": "https://github.com/chitranklabs/monoline-ui/issues"
	},
	"keywords": [
		"documentation",
		"static-site-generator",
		"markdown",
		"mdx",
		"astro",
		"docs"
	],
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./build": {
			"types": "./dist/build.d.ts",
			"default": "./dist/build.js"
		},
		"./dev": {
			"types": "./dist/dev.d.ts",
			"default": "./dist/dev.js"
		},
		"./components/*.astro": "./dist/components/*.astro"
	},
	"bin": {
		"monoline-docs": "dist/cli.js"
	},
	"files": [
		"dist",
		"templates",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=24.14.0"
	},
	"dependencies": {
		"@astrojs/markdown-satteri": "0.4.1",
		"@astrojs/mdx": "8.0.1",
		"@astrojs/react": "6.0.5",
		"astro": "7.3.2",
		"js-yaml": "5.4.1",
		"markdown-it": "15.0.1",
		"parse5": "8.0.1",
		"prismjs": "1.30.0"
	},
	"devDependencies": {
		"@types/prismjs": "1.26.6"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		}
	},
	"scripts": {
		"build": "node build.mjs",
		"test:consumer": "node test-consumer.mjs",
		"test:engine": "pnpm build && node test-engine.mjs",
		"typecheck": "tsc --noEmit"
	}
}
