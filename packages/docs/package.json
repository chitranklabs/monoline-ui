{
	"name": "@monoline/docs",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./build": {
			"types": "./dist/build.d.ts",
			"default": "./dist/build.js"
		},
		"./dev": {
			"types": "./dist/dev.d.ts",
			"default": "./dist/dev.js"
		}
	},
	"bin": {
		"monoline-docs": "./dist/cli.js"
	},
	"files": [
		"dist",
		"templates"
	],
	"engines": {
		"node": ">=24.14.0"
	},
	"dependencies": {
		"@astrojs/markdown-satteri": "0.4.1",
		"@astrojs/mdx": "8.0.1",
		"@astrojs/react": "6.0.5",
		"astro": "7.3.2",
		"js-yaml": "5.4.1",
		"markdown-it": "15.0.1",
		"parse5": "8.0.1",
		"prismjs": "1.30.0"
	},
	"devDependencies": {
		"@types/prismjs": "1.26.6"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"scripts": {
		"build": "node build.mjs",
		"test:consumer": "node test-consumer.mjs",
		"test:engine": "pnpm build && node test-engine.mjs",
		"typecheck": "tsc --noEmit"
	}
}
