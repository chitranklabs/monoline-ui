---
import type { NavigationItem } from "./navigation.ts"

interface Props {
	items: NavigationItem[]
	current: string
	base: string
	cleanUrls: boolean
}

const { items, current, base, cleanUrls } = Astro.props
const href = (route: string) =>
	base + (route === "/" ? "" : route.slice(1) + (cleanUrls ? "" : "/"))
const containsCurrent = (item: NavigationItem): boolean =>
	"href" in item ? item.href === current : item.items.some(containsCurrent)
---

<ul>
	{items.map((item) => (
		<li>
			{"href" in item ? (
				<a
					href={href(item.href)}
					aria-current={item.href === current ? "page" : undefined}
				>
					{item.label}
				</a>
			) : (
				<details class="nav-group" open={containsCurrent(item)}>
					<summary>{item.label}</summary>
					<Astro.self
						items={item.items}
						current={current}
						base={base}
						cleanUrls={cleanUrls}
					/>
				</details>
			)}
		</li>
	))}
</ul>
