---
import type { NavigationItem } from "./navigation.ts"

interface Props {
	items: NavigationItem[]
	current: string
	base: string
	cleanUrls: boolean
}

const { items, current, base, cleanUrls } = Astro.props
const href = (route: string) =>
	base + (route === "/" ? "" : route.slice(1) + (cleanUrls ? "" : "/"))
const containsCurrent = (item: NavigationItem): boolean =>
	"href" in item ? item.href === current : item.items.some(containsCurrent)
---

<ul>
	{items.map((item) => (
		<li>
			{"href" in item ? (
				<a
					href={href(item.href)}
					aria-current={item.href === current ? "page" : undefined}
				>
					<span>
						{item.icon && (
							<span class="nav-icon" aria-hidden="true">
								{item.icon}
							</span>
						)}
						{item.label}
					</span>
					{item.badge && <span class="nav-badge">{item.badge}</span>}
				</a>
			) : item.style === "plain" ? (
				<div
					class="nav-group nav-group-plain"
					role="group"
					aria-label={item.label}
				>
					<p class="nav-group-label">
						<span>
							{item.icon && (
								<span class="nav-icon" aria-hidden="true">
									{item.icon}
								</span>
							)}
							{item.label}
						</span>
						{item.badge && <span class="nav-badge">{item.badge}</span>}
					</p>
					<Astro.self
						items={item.items}
						current={current}
						base={base}
						cleanUrls={cleanUrls}
					/>
				</div>
			) : (
				<details
					class="nav-group"
					open={containsCurrent(item) || item.expanded === true}
				>
					<summary>
						<span>
							{item.icon && (
								<span class="nav-icon" aria-hidden="true">
									{item.icon}
								</span>
							)}
							{item.label}
						</span>
						{item.badge && <span class="nav-badge">{item.badge}</span>}
					</summary>
					<Astro.self
						items={item.items}
						current={current}
						base={base}
						cleanUrls={cleanUrls}
					/>
				</details>
			)}
		</li>
	))}
</ul>
