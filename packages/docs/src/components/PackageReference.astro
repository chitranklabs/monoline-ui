---
import Table from "./Table.astro"
interface Props {
	name: string
	version?: string
	packageHref: string
	sourceHref?: string
	compatibility: string[]
	exports: Array<{
		name: string
		type: string
		description: string
		required?: boolean
	}>
}
const {
	name,
	version,
	packageHref,
	sourceHref,
	compatibility,
	exports: rows,
} = Astro.props
if (typeof name !== "string" || !name.trim())
	throw new Error("PackageReference name is required")
for (const href of [packageHref, sourceHref].filter(
	(value) => value !== undefined
)) {
	let url: URL
	try {
		url = new URL(href!)
	} catch {
		throw new Error("PackageReference links must be absolute HTTP(S) URLs")
	}
	if (
		!["http:", "https:"].includes(url.protocol) ||
		url.username ||
		url.password
	)
		throw new Error(
			"PackageReference links must be absolute HTTP(S) URLs without credentials"
		)
}
if (typeof packageHref !== "string")
	throw new Error("PackageReference packageHref is required")
if (version !== undefined && (typeof version !== "string" || !version.trim()))
	throw new Error("PackageReference version must be nonempty")
if (
	!Array.isArray(compatibility) ||
	!compatibility.length ||
	compatibility.some((value) => typeof value !== "string" || !value.trim())
)
	throw new Error(
		"PackageReference compatibility must contain explicit supported environments"
	)
if (
	!Array.isArray(rows) ||
	rows.some(
		(row) =>
			!row ||
			typeof row.name !== "string" ||
			!row.name.trim() ||
			typeof row.type !== "string" ||
			!row.type.trim() ||
			typeof row.description !== "string" ||
			(row.required !== undefined && typeof row.required !== "boolean")
	)
)
	throw new Error(
		"PackageReference exports require name, type, description and optional boolean required"
	)
const entries = rows.map((row) => ({
	...row,
	required:
		row.required === undefined ? undefined : row.required ? "Yes" : "No",
}))
---

<section
	class="docs-package-reference"
	aria-label={`${name} package reference`}
>
	<header class="docs-package-header">
		<div class="docs-package-identity">
			<strong>{name}</strong>
			{version && <span class="docs-badge">{version}</span>}
		</div>
		<nav aria-label={`${name} resources`}>
			<a href={packageHref}>
				Package <span aria-hidden="true">↗</span>
			</a>
			{sourceHref && (
				<a href={sourceHref}>
					Source <span aria-hidden="true">↗</span>
				</a>
			)}
		</nav>
	</header>
	<div class="docs-package-compatibility">
		<span>Compatibility</span>
		<ul>
			{compatibility.map((value) => (
				<li>{value}</li>
			))}
		</ul>
	</div>
	<Table
		variant="reference"
		columns={[
			{ key: "name", label: "Name", format: "code" },
			{ key: "type", label: "Type", format: "code" },
			{ key: "required", label: "Required", format: "code" },
			{ key: "description", label: "Description" },
		]}
		rows={entries}
		caption="Package exports"
	/>
	<slot />
</section>
