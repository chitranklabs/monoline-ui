---
interface Entry {
	name: string
	children?: Entry[]
	expanded?: boolean
	highlight?: boolean
}
interface Props {
	items: Entry[]
	label?: string
	_nested?: boolean
}
const { items, label = "Project files", _nested = false } = Astro.props
if (!_nested) {
	const seen = new Set<unknown>()
	function validate(entries: Entry[], depth = 0): void {
		if (!Array.isArray(entries) || depth > 20 || seen.has(entries))
			throw new Error(
				"FileTree items must be arrays without cycles and at most 20 nested folders"
			)
		seen.add(entries)
		for (const entry of entries) {
			if (!entry || typeof entry.name !== "string" || !entry.name.trim())
				throw new Error("FileTree names must be nonempty")
			for (const key of ["expanded", "highlight"] as const)
				if (entry[key] !== undefined && typeof entry[key] !== "boolean")
					throw new Error(`FileTree ${key} must be a boolean`)
			if (entry.children !== undefined) validate(entry.children, depth + 1)
			else if (entry.expanded !== undefined)
				throw new Error("FileTree expanded applies only to folders")
		}
		seen.delete(entries)
	}
	validate(items)
	if (typeof label !== "string" || !label.trim())
		throw new Error("FileTree label must be nonempty")
}
---

<div class="docs-file-tree" role="group" aria-label={label}>
	<ul>
		{items.map((entry) => (
			<li>
				{entry.children !== undefined ? (
					<details open={entry.expanded !== false}>
						<summary>
							<svg
								class="docs-tree-chevron"
								viewBox="0 0 16 16"
								width="16"
								height="16"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								aria-hidden="true"
							>
								<path d="m6 4 4 4-4 4" />
							</svg>
							<svg
								class="docs-tree-icon"
								viewBox="0 0 24 24"
								width="16"
								height="16"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d="M3 7V5a2 2 0 0 1 2-2h5l2 3h7a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" />
							</svg>
							<span data-highlight={entry.highlight || undefined}>
								{entry.name}
							</span>
						</summary>
						<Astro.self
							items={entry.children}
							label={`${entry.name} contents`}
							_nested={true}
						/>
					</details>
				) : (
					<span class="docs-file" data-highlight={entry.highlight || undefined}>
						<svg
							class="docs-tree-icon"
							viewBox="0 0 24 24"
							width="16"
							height="16"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9Z" />
							<path d="M14 3v6h6" />
						</svg>
						<span>{entry.name}</span>
					</span>
				)}
			</li>
		))}
	</ul>
</div>
